# Copia in .env e compila. NON committare .env (è in .gitignore).
# Genera i valori segreti con i comandi sotto. Nessun valore qui è reale.
#
#   WEBEEP_SECRET_KEY:      openssl rand -base64 32
#   WEBEEP_ADMIN_PASSWORD:  openssl rand -base64 18
#   WEBEEP_PAIRING_KEY:     openssl rand -hex 32
#   CLOUDFLARE_TUNNEL_TOKEN: dalla dashboard Cloudflare (solo con il profilo tunnel)

# Dominio pubblico (solo host, senza https://). Caddy lo usa per il certificato.
WEBEEP_DOMAIN=webeep.example.it

# Origine pubblica, senza slash finale: deve corrispondere a WEBEEP_DOMAIN.
WEBEEP_PUBLIC_URL=https://webeep.example.it

# Chiave AES-256-GCM dello stato: 32 byte in base64 (44 caratteri). Senza di lei lo stato
# cifrato non si legge: va conservata anche fuori dal server.
WEBEEP_SECRET_KEY=

# Password della pagina di autorizzazione (/authorize): almeno 12 caratteri.
WEBEEP_ADMIN_PASSWORD=

# Chiave degli endpoint /pair, usata dall'app desktop per accoppiare WeBeep: almeno 32 caratteri.
WEBEEP_PAIRING_KEY=

# Valori di default dell'immagine: si cambiano solo se serve.
# PORT=8787
# WEBEEP_DATA_DIR=/data

# Impostato a true da docker-compose.yml: il server sta dietro un proxy fidato.
WEBEEP_TRUST_PROXY=true

# Solo per il profilo tunnel (Cloudflare Tunnel). Token del tunnel, dalla dashboard Cloudflare.
# CLOUDFLARE_TUNNEL_TOKEN=
