# Copia in .env e compila. NON committare .env (è in .gitignore).
# Genera i valori segreti con i comandi sotto. Nessun valore qui è reale.
#
#   WEBEEP_SECRET_KEY:       openssl rand -base64 32
#   WEBEEP_OIDC_CLIENT_SECRET: copiato dal provider OAuth2 di Authentik (vedi README, sezione Authentik)
#   CLOUDFLARE_TUNNEL_TOKEN: dalla dashboard Cloudflare (solo con il profilo tunnel)

# Dominio pubblico (solo host, senza https://). Caddy lo usa per il certificato.
WEBEEP_DOMAIN=webeep.example.it

# Origine pubblica, senza slash finale: deve corrispondere a WEBEEP_DOMAIN.
# Il redirect URI verso Authentik è WEBEEP_PUBLIC_URL/oidc/callback.
WEBEEP_PUBLIC_URL=https://webeep.example.it

# Chiave AES-256-GCM dello stato: 32 byte in base64 (44 caratteri). Senza di lei lo stato
# cifrato non si legge: va conservata anche fuori dal server.
WEBEEP_SECRET_KEY=

# Login con Authentik (OIDC). Il provider è OAuth2/OpenID confidenziale, creato in Authentik
# (vedi README, sezione Authentik). Chi accede deve appartenere al gruppo indicato.
# Issuer dell'applicazione Authentik, es. https://auth.example.com/application/o/webeep/
WEBEEP_OIDC_ISSUER=
# Client ID del provider (pubblico, ma sta qui per completezza).
WEBEEP_OIDC_CLIENT_ID=
# Client secret del provider: segreto, si copia da Authentik e non si mostra mai in log o pagine.
WEBEEP_OIDC_CLIENT_SECRET=
# Gruppo Authentik richiesto per accedere al server. Default: webeep.
WEBEEP_OIDC_ALLOWED_GROUP=webeep

# Versione dell'immagine GHCR da usare nel compose (vedi README, sezione Immagine GHCR).
# Vuota o latest: l'ultima release. Con il build locale non serve.
# WEBEEP_VERSION=latest

# Valori di default dell'immagine: si cambiano solo se serve.
# PORT=8787
# WEBEEP_DATA_DIR=/data

# Impostato a true da docker-compose.yml: il server sta dietro un proxy fidato.
WEBEEP_TRUST_PROXY=true

# Solo per il profilo tunnel (Cloudflare Tunnel). Token del tunnel, dalla dashboard Cloudflare.
# CLOUDFLARE_TUNNEL_TOKEN=
