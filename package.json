{
  "name": "webeep-desktop-monorepo",
  "version": "26.3.2",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --filter @webeep/desktop dev",
    "dev:web": "pnpm --filter @webeep/desktop dev:web",
    "diagnose": "pnpm --filter @webeep/desktop diagnose",
    "web": "pnpm --filter @webeep/desktop web",
    "server:dev": "pnpm --filter @webeep/server dev",
    "server:build": "pnpm --filter @webeep/server build",
    "build": "pnpm -r typecheck && pnpm --filter @webeep/desktop build && pnpm --filter @webeep/server build",
    "dist:linux": "pnpm typecheck && pnpm --filter @webeep/desktop dist:linux",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @webeep/moodle-api test && pnpm --filter @webeep/server test && pnpm test:release",
    "test:release": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
