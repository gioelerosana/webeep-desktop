{
  "name": "webeep-desktop-monorepo",
  "version": "26.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --filter @webeep/desktop dev",
    "dev:web": "pnpm --filter @webeep/desktop dev:web",
    "diagnose": "pnpm --filter @webeep/desktop diagnose",
    "web": "pnpm --filter @webeep/desktop web",
    "build": "pnpm -r typecheck && pnpm --filter @webeep/desktop build",
    "dist:linux": "pnpm typecheck && pnpm --filter @webeep/desktop dist:linux",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @webeep/moodle-api test && pnpm test:release",
    "test:release": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
