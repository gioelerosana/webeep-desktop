{
  "name": "webeep-desktop-monorepo",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --filter @webeep/desktop dev",
    "dev:web": "pnpm --filter @webeep/desktop dev:web",
    "diagnose": "pnpm --filter @webeep/desktop diagnose",
    "build": "pnpm -r typecheck && pnpm --filter @webeep/desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @webeep/moodle-api test"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
