{
  "name": "@webeep/desktop",
  "version": "0.0.1",
  "license": "MIT",
  "author": "Gioele",
  "private": true,
  "productName": "WeBeep Desktop",
  "desktopName": "webeep-desktop.desktop",
  "description": "Client desktop per WeBeep, il Moodle del Politecnico di Milano",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "diagnose": "WEBEEP_DIAGNOSE=1 electron-vite dev",
    "web": "electron-vite build && WEBEEP_WEB=1 electron .",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage --x64 --publish never"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@webeep/moodle-api": "workspace:*",
    "@webeep/ui-kit": "workspace:*",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
